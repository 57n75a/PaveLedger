{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": [
    "yul1"
  ],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/auto-close",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 6 */5 * *"
    }
  ]
}
